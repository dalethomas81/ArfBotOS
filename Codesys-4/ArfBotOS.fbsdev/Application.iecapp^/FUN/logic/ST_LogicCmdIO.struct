TYPE ST_LogicCmdIO :
STRUCT
	Input: ARRAY [GVL_App.DIG_IN_ARR_BEG..GVL_App.DIG_IN_ARR_END] OF BOOL;
	Output: ARRAY [GVL_App.DIG_OUT_ARR_BEG..GVL_App.DIG_OUT_ARR_END] OF BOOL;
	Pwm: ARRAY [GVL_App.PWM_OUT_ARR_BEG..GVL_App.PWM_OUT_ARR_END] OF BYTE;
	Register: ARRAY [GVL_App.REG_ARR_BEG..GVL_App.REG_ARR_END] OF UDINT;
	Counter: ARRAY [GVL_App.REG_ARR_BEG..GVL_App.REG_ARR_END] OF UDINT;
END_STRUCT
END_TYPE

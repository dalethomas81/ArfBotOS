{attribute 'qualified_only'}

VAR_GLOBAL CONSTANT
    
    //
    pi: LREAL:=3.14159265358979323846;
	
    // refer to the position control loop tab in the axis configuration
    // Application Values | min:-100 zero:0 max:100
    // Output Values | min:-16#2710 zero:0 max:16#2710
	c_PosCtrl_MaxVel_TU  : LREAL := 100.0;    // Application [t.u./s] maximum
	c_PosCtrl_MaxVel_Int : LREAL := 10000.0;  // Output value maximum
	c_PosCtrl_VelScale   : LREAL := 100.0 / 10000.0;
	
	// array sizes
	DIG_IN_ARR_BEG: INT:=0;
	DIG_IN_ARR_END: INT:=15;
	DIG_OUT_ARR_BEG: INT:=0;
	DIG_OUT_ARR_END: INT:=15;
	PWM_OUT_ARR_BEG: INT:=0;
	PWM_OUT_ARR_END: INT:=15;
	PROG_CMDS_ARR_BEG: INT:=0;
	PROG_CMDS_ARR_END: INT:=49; // total number of commands in a program
	PROG_ARR_BEG: INT:=0;
	PROG_ARR_END: INT:=19; // total number of programs 
	POS_ARR_BEG: INT:=0;
	POS_ARR_END: INT:=49; // total number of stored positions
	VIS_ARR_BEG: INT:=0;
	VIS_ARR_END: INT:=49; // total number of vision registers
	FLG_ARR_BEG: INT:=0;
	FLG_ARR_END: INT:=49; // total number of flags
	REG_ARR_BEG: INT:=0;
	REG_ARR_END: INT:=49; // total number of registers
	POSCONT_ARR_BEG: INT:=0;
	POSCONT_ARR_END: INT:=5; // total number of axes
	
	// length of command strings for command processor.
	// if this is reduced then commands may stop working.
	COMMAND_LEN: UINT:=255;

	// stored positions
	POSE_1_IDX: INT:=34; // coordinates of pose 1
	POSE_2_IDX: INT:=35; // coordinates of pose 2
	POSE_3_IDX: INT:=36; // coordinates of pose 3
	POSE_4_IDX: INT:=37; // coordinates of pose 4
	POSE_5_IDX: INT:=38; // coordinates of pose 5
	//RESERVED: INT:=39; // RESERVED
	//RESERVED: INT:=40; // RESERVED
	//RESERVED: INT:=41; // RESERVED
	//RESERVED: INT:=42; // RESERVED
	SPEEDS_IDX: INT:=43; // max vel, max accel/decel, max jerk, vel factor, accel/decel factor, jerk factor
	HOM_POS_IDX: INT:=44; // homing offsets
	DEC_START_POS: INT:=45; // start position for the nc decoder
	TCP_POS_IDX: INT:=46; // tool center point offset
	PC2_POS_IDX: INT:=47; // part 2 coordinate system offset
	PC1_POS_IDX: INT:=48; // part 1 coordinate system offset
	MCS_POS_IDX: INT:=49; // machine (robot) coordinate system offset
	
	// vision registers
	//RESERVED: INT:=VIS_ARR_END-4; // RESERVED
	//RESERVED: INT:=VIS_ARR_END-3; // RESERVED
	//RESERVED: INT:=VIS_ARR_END-2; // RESERVED
	//RESERVED: INT:=VIS_ARR_END-1; // RESERVED
	//RESERVED: INT:=VIS_ARR_END; // RESERVED
	
	// flags
	HOM_TO_POSE_IDX: INT:=44;
	//RESERVED: INT:=45;
	//RESERVED: INT:=46;
	INIT_DRV_IDX: INT:=47;
	HOME_COMPLETE: INT:=48;
	INIT_POS_IDX: INT:=49;
	
END_VAR

VAR_GLOBAL
	
	// task scan times
	dwMainInterval: DWORD;
	dwMotionInterval: DWORD;
	dwVisionInterval: DWORD;
	dwVisuInterval: DWORD;
    dwEtherCATInterval: DWORD;
    
	//
	PowerOn:BOOL;
	Reset: BOOL;
	ResetRtrig: R_TRIG;
	Enable: BOOL;
    
    // alarms
    sLastFault : STRING;
    xClearHistory : BOOL;
    xActiveAlarm : BOOL;
	
	// dialog results
	// TODO: this seems like a bad idea. what happens is 2 clients have an HMI open and one presses yes and the other presses no?
	AreYouSure_Home_Yes: BOOL;
	AreYouSure_Home_No: BOOL;
	
	// command IO
	CmdIO: ST_LogicCmdIO;
	
	// cnc (testing)
	g_x: REAL:=50; // feed rate
	g_y: REAL:=50;
	g_gripper: INT:=0;
	Servo0Position: BYTE;
	
    // license
	LicenseStatus: FB_LicenseStatus;
    
    // visu
    lrGripperOpen: LREAL;
    // https://content.helpme-codesys.com/en/libs/SM3_CNC/4.14.0.0/SM_CNC_Data-types/SoftMotion-CNC/SMC_ORI_CONVENTION.html
    OriConvention: SMC_ORI_CONVENTION := SMC_ORI_CONVENTION.ZYZ;
    
    
END_VAR
